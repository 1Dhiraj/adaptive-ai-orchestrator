# Copy to .env.local and fill in what you have.
# Everything is optional: with no keys at all the system runs end to end on a
# deterministic offline LLM and simulated tools.

# --- LLM ---------------------------------------------------------------
# Explicit LLM_PROVIDER wins; otherwise NVIDIA_API_KEY selects NVIDIA.
# Without a NVIDIA key, use the offline stub. Select other providers explicitly.
# Ollama is never auto-selected (it needs no key) -- set LLM_PROVIDER=ollama
# explicitly to use it.
LLM_PROVIDER=
# Set to 1 to force the offline stub regardless of any key or LLM_PROVIDER.
ORCHESTRATOR_STUB_LLM=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint: Azure OpenAI, OpenRouter, vLLM...
OPENAI_BASE_URL=https://api.openai.com/v1

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional role overrides; blank inherits NVIDIA_MODEL. Individual specialists
# can use NVIDIA_MODEL_<UPPERCASE_ROLE>, e.g. NVIDIA_MODEL_BACKEND.
NVIDIA_MODEL_AGENTS=
NVIDIA_MODEL_PLANNER=
NVIDIA_MODEL_CHANGE_TRANSLATOR=
NVIDIA_MODEL_EQUIVALENCE_JUDGE=
# Vision-only desktop locator. Keep the fast general model above for planning.
NVIDIA_MODEL_SCREEN_LOCATOR=nvidia/nemotron-3-nano-omni-30b

# Local, free, no key -- install Ollama, `ollama pull llama3.1`, then
# LLM_PROVIDER=ollama above.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Orchestration -----------------------------------------------------
ORCHESTRATOR_MAX_WORKERS=4
ORCHESTRATOR_CONTEXT_BUDGET=1200
# Fact assumptions + owner-forced (P4) invalidation. False keeps legacy signatures.
ORCHESTRATOR_CHANGE_AWARE=true
# Opt-in only: remains unmeasured on NVIDIA. Exact cutoff works without this.
ORCHESTRATOR_SEMANTIC_CUTOFF=false
ORCHESTRATOR_EQUIVALENCE_THRESHOLD=0.95
ORCHESTRATOR_PLAN_TOKEN_BUDGET=20000
ORCHESTRATOR_DB=orchestrator_state.db
ORCHESTRATOR_STATE_URL=
ORCHESTRATOR_BROKER_URL=
ORCHESTRATOR_RESULT_BACKEND=
# Optional but strongly recommended if the server is reachable by other devices.
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_KEYS=
ORCHESTRATOR_RATE_LIMIT_PER_MINUTE=120

# OIDC / enterprise SSO
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_TENANT_CLAIM=org_id
OIDC_ROLE_CLAIM=role

# Encrypted local vault or cloud secret manager
ORCHESTRATOR_VAULT_KEY=
ORCHESTRATOR_SECRET_BACKEND=local
ORCHESTRATOR_AWS_SECRET_ID=adaptive-orchestrator

# --- Tools (each falls back to a safe local equivalent when unset) ------
# vcs chain:      github -> github_cli -> artifact_store
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# database chain: postgres -> postgres_cli -> sqlite_local
DATABASE_URL=

# ci chain:       ci -> local_test_runner
# Opt in explicitly before any local command is executed.
ORCHESTRATOR_TEST_CMD=
# Software workflows receive a confined workspace automatically. This flag
# enables their restricted terminal; commands still require action approval.
ORCHESTRATOR_ALLOW_TERMINAL=

# notify chain:   slack -> email -> console_notify
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Gmail SMTP alternative. Use a Google app password, never your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Dedicated connectors
STRIPE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=adaptive-orchestrator

# --- Hermes desktop worker (optional) ---------------------------------
# Install Hermes Agent and run:
#   hermes setup
#   hermes computer-use install
#   hermes computer-use doctor
# Then opt in. Desktop calls still pause at the orchestrator approval gate.
ORCHESTRATOR_ALLOW_DESKTOP=
# Only needed if the executable is not named `hermes` or is not on PATH.
HERMES_EXECUTABLE=hermes
