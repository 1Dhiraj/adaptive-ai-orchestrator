FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir playwright==1.62.0
COPY --chown=pwuser:pwuser . .
RUN mkdir -p /app/workspace /app/artifacts && chown -R pwuser:pwuser /app
USER pwuser
CMD ["celery", "-A", "orchestrator.distributed:app", "worker", "--loglevel=INFO", "-Q", "browser", "--concurrency=1"]
